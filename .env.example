# متغیرهای محیطی اختیاری Matixo (در شِل تنظیم کن؛ در فایل تنظیمات ذخیره نمی‌شوند)
# Optional environment variables (set them in your shell; they are never written to config.json)

# پورت پنل و پروکسی برای همین اجرا / port for this run
MATIXO_PORT=3456
# توکن داخلی که Claude Code برای اتصال به Matixo می‌فرستد / local token Claude Code uses
MATIXO_AUTH_TOKEN=matixo-local
# مسیر ذخیره‌ی config.json (پیش‌فرض: پوشه data پروژه) / where config.json lives
# MATIXO_DATA_DIR=/path/to/matixo-data
